<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Load Google Sans for the backend, portal and sign-in pages (DESIGN.md §2.2). -->
    <template id="layout_google_sans" inherit_id="web.layout" name="Brightloop Google Sans">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700&amp;display=swap"/>
        </xpath>
    </template>
</odoo>
