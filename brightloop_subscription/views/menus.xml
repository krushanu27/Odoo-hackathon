<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level app, visible to Staff and Admin (Admin implies Staff) -->
    <menuitem id="menu_subscription_root"
              name="Subscriptions"
              sequence="25"
              groups="group_subscription_staff"/>

    <menuitem id="menu_subscription_main"
              name="Subscriptions"
              parent="menu_subscription_root"
              action="subscription_action"
              sequence="10"/>

    <!-- Configuration: Admin only -->
    <menuitem id="menu_subscription_config"
              name="Configuration"
              parent="menu_subscription_root"
              sequence="100"
              groups="group_subscription_admin"/>

    <menuitem id="menu_subscription_plan"
              name="Plans"
              parent="menu_subscription_config"
              action="subscription_plan_action"
              sequence="10"/>
</odoo>
