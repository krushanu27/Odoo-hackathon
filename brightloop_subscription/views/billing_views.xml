<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Billing, customers and catalogue screens inside the Subscriptions app.
        Invoices, payments, taxes and products are native Odoo records; these
        actions give staff one place to work without switching apps.
        Standalone (primary) views are used so native Invoicing screens are untouched.
    -->

    <!-- ================= Subscription invoices ================= -->
    <record id="subscription_invoice_view_list" model="ir.ui.view">
        <field name="name">account.move.list.subscription</field>
        <field name="model">account.move</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="false" sample="1"
                  decoration-muted="state == 'cancel'"
                  decoration-danger="state == 'posted' and payment_state in ('not_paid', 'partial') and invoice_date_due and invoice_date_due &lt; current_date">
                <field name="name" class="fw-bold font-monospace"/>
                <field name="partner_id"/>
                <field name="subscription_id" optional="show"/>
                <field name="subscription_period_start" string="Period" optional="hide"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="amount_untaxed_signed" string="Untaxed" sum="Untaxed" optional="hide"/>
                <field name="amount_total_signed" string="Total" sum="Total"/>
                <field name="amount_residual_signed" string="Amount Due" sum="Amount Due"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancel'"/>
                <field name="payment_state" string="Payment" widget="badge"
                       invisible="state != 'posted'"
                       decoration-danger="payment_state == 'not_paid'"
                       decoration-warning="payment_state in ('partial', 'in_payment')"
                       decoration-success="payment_state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="subscription_invoice_view_search" model="ir.ui.view">
        <field name="name">account.move.search.subscription</field>
        <field name="model">account.move</field>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Invoice"/>
                <field name="partner_id"/>
                <field name="subscription_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_posted" string="Confirmed" domain="[('state', '=', 'posted')]"/>
                <filter name="filter_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="filter_paid" string="Paid"
                        domain="[('state', '=', 'posted'), ('payment_state', 'in', ('paid', 'in_payment'))]"/>
                <filter name="filter_outstanding" string="Outstanding"
                        domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter name="filter_overdue" string="Overdue"
                        domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial')), ('invoice_date_due', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_invoice_date" string="Invoice Date" date="invoice_date"/>
                <filter name="filter_due_date" string="Due Date" date="invoice_date_due"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_payment_state" string="Payment" context="{'group_by': 'payment_state'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_subscription" string="Subscription" context="{'group_by': 'subscription_id'}"/>
                    <filter name="group_month" string="Invoice Month" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_subscription_invoices" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('subscription_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'create': False}</field>
        <field name="search_view_id" ref="subscription_invoice_view_search"/>
        <field name="view_ids" eval="[
            Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('subscription_invoice_view_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('account.view_move_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No subscription invoices yet</p>
            <p>Invoices are created automatically from active subscriptions on their billing date,
               or straight away with <b>Invoice Now</b> on a subscription.</p>
        </field>
    </record>

    <!-- ================= Payments ================= -->
    <record id="action_subscription_payments" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', 'inbound'), ('partner_type', '=', 'customer')]</field>
        <field name="context">{'default_payment_type': 'inbound', 'default_partner_type': 'customer'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No payments recorded yet</p>
            <p>Open an invoice and use <b>Register Payment</b> to record the method, amount, date and a memo.</p>
        </field>
    </record>

    <!-- ================= Customers ================= -->
    <record id="action_subscription_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'res_partner_search_mode': 'customer', 'default_is_company': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first customer</p>
        </field>
    </record>

    <!-- ================= Catalogue (admin) ================= -->
    <record id="action_subscription_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'default_sale_ok': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a product</p>
            <p>Set the sales price, cost and taxes, then add variants such as Brand with a price extra.</p>
        </field>
    </record>

    <record id="action_subscription_attributes" model="ir.actions.act_window">
        <field name="name">Variant Attributes</field>
        <field name="res_model">product.attribute</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_subscription_taxes" model="ir.actions.act_window">
        <field name="name">Taxes</field>
        <field name="res_model">account.tax</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type_tax_use', '=', 'sale')]</field>
        <field name="context">{'default_type_tax_use': 'sale'}</field>
    </record>

    <!-- ================= Menus ================= -->
    <menuitem id="menu_subscription_billing"
              name="Billing"
              parent="menu_subscription_root"
              sequence="20"/>
    <menuitem id="menu_subscription_invoices"
              name="Invoices"
              parent="menu_subscription_billing"
              action="action_subscription_invoices"
              sequence="10"/>
    <menuitem id="menu_subscription_payments"
              name="Payments"
              parent="menu_subscription_billing"
              action="action_subscription_payments"
              sequence="20"/>
    <menuitem id="menu_subscription_customers"
              name="Customers"
              parent="menu_subscription_root"
              action="action_subscription_customers"
              sequence="30"/>

    <menuitem id="menu_subscription_products"
              name="Products"
              parent="menu_subscription_config"
              action="action_subscription_products"
              sequence="40"/>
    <menuitem id="menu_subscription_attributes"
              name="Variant Attributes"
              parent="menu_subscription_config"
              action="action_subscription_attributes"
              sequence="45"/>
    <menuitem id="menu_subscription_taxes"
              name="Taxes"
              parent="menu_subscription_config"
              action="action_subscription_taxes"
              sequence="50"/>
</odoo>
