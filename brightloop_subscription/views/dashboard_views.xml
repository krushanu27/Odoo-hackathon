<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Finance dashboard: OWL client action in static/src/dashboard/,
         figures from subscription.dashboard.get_dashboard_data(). -->
    <record id="action_subscription_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">brightloop_subscription.dashboard</field>
    </record>

    <!-- Lowest sequence: opening the Subscriptions app lands here. -->
    <menuitem id="menu_subscription_dashboard"
              name="Dashboard"
              parent="menu_subscription_root"
              action="action_subscription_dashboard"
              sequence="5"/>
</odoo>
