<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show which subscription and billing period an invoice belongs to. -->
    <record id="account_move_form_subscription" model="ir.ui.view">
        <field name="name">account.move.form.subscription</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="subscription_id" invisible="not subscription_id" readonly="1"/>
                <field name="subscription_period_start" string="Billing Period From"
                       invisible="not subscription_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
