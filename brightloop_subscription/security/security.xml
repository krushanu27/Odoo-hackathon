<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Three roles from the problem statement:
        - Staff: day-to-day work, limited access. Internal user who can
          create and send invoices and register payments (native Billing).
        - Admin: everything Staff can do, plus configuration (plans,
          discounts, taxes, product variants). Implies Staff.
        - Customer: Odoo's native Portal user (base.group_portal).
          Record rules will restrict them to their own data.

        "Only the admin can add staff" is enforced natively: creating users
        requires Odoo's Settings / Access Rights group, which we never grant
        to Staff.
    -->
    <record id="group_subscription_staff" model="res.groups">
        <field name="name">Subscription Staff</field>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('account.group_account_invoice')),
        ]"/>
    </record>

    <record id="group_subscription_admin" model="res.groups">
        <field name="name">Subscription Admin</field>
        <field name="implied_ids" eval="[
            Command.link(ref('group_subscription_staff')),
            Command.link(ref('account.group_account_manager')),
            Command.link(ref('product.group_product_variant')),
        ]"/>
    </record>
</odoo>
